# ---------------------------------------------------------------------------
# CloverCode - environment variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real credentials.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# One of: development | test | production
# Next.js sets this automatically; only override it deliberately.
# NODE_ENV=development

# --- Application -----------------------------------------------------------
# Canonical origin of the CloverCode dashboard. Used to build absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log verbosity for the structured logger: debug | info | warn | error
LOG_LEVEL=debug

# --- Supabase (public) -----------------------------------------------------
# These two are exposed to the browser by design. They are safe to publish:
# access control is enforced by Row Level Security, never by key secrecy.
#
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (`sb_publishable_...`). Legacy projects may still issue an
# `anon` JWT key instead; both are passed as the same argument and either value
# works in this variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Supabase (server-only) ------------------------------------------------
# NOT used in Phase 00. The service_role / secret key bypasses Row Level
# Security entirely and must NEVER be exposed to the browser or prefixed with
# NEXT_PUBLIC_. It is introduced in Phase 04 (Super Admin) together with the
# guarded admin client.
#
# SUPABASE_SECRET_KEY=
