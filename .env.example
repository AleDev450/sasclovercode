# ---------------------------------------------------------------------------
# CloverCode - environment variables
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real credentials.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# One of: development | test | production
# Next.js sets this automatically; only override it deliberately.
# NODE_ENV=development

# --- Application -----------------------------------------------------------
# Canonical origin of the CloverCode dashboard. Used to build absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Log verbosity for the structured logger: debug | info | warn | error
LOG_LEVEL=debug

# --- Supabase (public) -----------------------------------------------------
# These two are exposed to the browser by design. They are safe to publish:
# access control is enforced by Row Level Security, never by key secrecy.
#
# Project URL, e.g. https://abcdefghijklmno.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (`sb_publishable_...`). Legacy projects may still issue an
# `anon` JWT key instead; both are passed as the same argument and either value
# works in this variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Supabase (server-only) ------------------------------------------------
# OPTIONAL. Secret key (`sb_secret_...`, Supabase -> Project Settings -> API
# Keys). It bypasses Row Level Security entirely and must NEVER be exposed to
# the browser or prefixed with NEXT_PUBLIC_.
#
# Used ONLY by src/lib/supabase/admin.ts, so the Super Admin can create a new
# tenant owner's account with a temporary password. Leave it empty and the
# platform can still assign owners who already have an account.
SUPABASE_SECRET_KEY=

# --- Multi-tenancy (Phase 01) ----------------------------------------------
# Tenant served when you browse plain `http://localhost:3000`.
#
# Prefer `http://{slug}.localhost:3000`, which needs no configuration and
# exercises the exact same lookup as production. This variable is the fallback
# for tooling that cannot use a subdomain.
#
# Ignored entirely when NODE_ENV=production: it can never select a tenant in a
# deployed environment.
DEV_TENANT_SLUG=sugurolls
